<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.0.0</Version>
    <AssemblyName>ProxyPlugin</AssemblyName>
    <RootNamespace>ProxyPlugin</RootNamespace>
    <PackageProjectUrl>https://github.com/Loskh/ProxyPlugin</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProxyPlugin.Core\ProxyPlugin.Core.csproj" />
    <!--
      Dalamud 15 does not bundle Harmony AND loads plugins into a *collectible* AssemblyLoadContext.
      MonoMod (Harmony's detour engine) cannot run from a collectible context, so 0Harmony must live
      in the non-collectible Default ALC instead. To force that we reference Harmony compile-only
      (keep it out of deps.json) and ship 0Harmony.dll under libs\ ourselves; HarmonyLoader pre-loads
      it into the Default ALC at startup. See HarmonyLoader.cs.
    -->
    <PackageReference Include="Lib.Harmony" Version="2.4.2" GeneratePathProperty="true">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Ship 0Harmony.dll inside libs\ rather than next to the plugin DLL. Dalamud's per-plugin loader
    probes "<pluginDir>\0Harmony.dll" (and deps.json); keeping the file out of both paths forces its
    final fallback to resolve "0Harmony" from the Default ALC, where HarmonyLoader has placed it.
  -->
  <ItemGroup>
    <None Include="$(PkgLib_Harmony)\lib\net10.0\0Harmony.dll"
          Link="libs\0Harmony.dll"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>
</Project>
