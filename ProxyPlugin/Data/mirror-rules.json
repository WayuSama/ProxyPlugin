// ProxyPlugin built-in mirror ruleset (embedded; ships with the plugin version).
// Each rule rewrites a request via a regex over "host/path"; the scheme, port, query and
// fragment are preserved automatically. Anchor the Pattern with ^ to match from the host,
// and let the text up to the first '/' in Replacement become the new (mirror) host.
// These are TEMPLATES: replace each Replacement host with a real maintainer-operated
// mirror/reverse-proxy domain, then set "Enabled": true before release.
// Rules ship DISABLED so the default install never rewrites to a dead mirror.
[
  {
    "Id": "github-raw",
    "Pattern": "^raw\\.githubusercontent\\.com",
    "Replacement": "raw.mirror.example.cn",
    "Enabled": false
  },
  {
    "Id": "github-release-assets",
    "Pattern": "^objects\\.githubusercontent\\.com",
    "Replacement": "objects.mirror.example.cn",
    "Enabled": false
  },
  {
    "Id": "crowdin-api",
    "Pattern": "^api\\.crowdin\\.com/api/v2",
    "Replacement": "crowdin.mirror.example.cn/api/v2",
    "Enabled": false
  }
]
